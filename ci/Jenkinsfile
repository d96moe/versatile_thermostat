// =============================================================================
// Jenkinsfile — versatile_thermostat fork (d96moe)
// Runs the full pytest suite directly in a Python venv on the Jenkins agent.
// =============================================================================

pipeline {
    agent { label 'built-in' }

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Branch to test')
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                    url: 'https://github.com/d96moe/versatile_thermostat.git'
            }
        }

        stage('Test') {
            steps {
                sh """
                    python3 -m venv .venv
                    .venv/bin/pip install -q --upgrade pip
                    # requirements_dev.txt pins homeassistant==2026.3.1 which requires
                    # Python >=3.14.2. Jenkins agent runs 3.13.x, so pin a compatible
                    # version first and let pip install the rest with --ignore-requires-python
                    # to override the pin from requirements_dev.txt.
                    .venv/bin/pip install -q --ignore-requires-python "homeassistant==2026.2.3"
                    .venv/bin/pip install -q -r requirements_test.txt
                    .venv/bin/python -m pytest tests/ \
                        -p no:cacheprovider \
                        --tb=short \
                        -q \
                        --junitxml=test-results.xml
                """
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'test-results.xml'
        }
        success { echo 'All tests passed.' }
        failure { echo 'Tests failed — check log above.' }
    }
}

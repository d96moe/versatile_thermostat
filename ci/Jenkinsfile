// =============================================================================
// Jenkinsfile — versatile_thermostat fork (d96moe)
// Runs the full pytest suite directly in a Python venv on the Jenkins agent.
// =============================================================================

pipeline {
    agent { label 'built-in' }

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Branch to test')
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                    url: 'https://github.com/d96moe/versatile_thermostat.git'
            }
        }

        stage('Test') {
            steps {
                // --clear: the workspace .venv persists between builds and plain
                // `venv .venv` keeps every old package. A stale
                // pytest_homeassistant_custom_component plugin from an earlier build
                // crashed pytest at startup against HA 2026.11.0 (#42) — and the
                // stale test-results.xml from a previous run still showed 1057 passed.
                sh """
                    rm -f test-results.xml
                    /usr/local/bin/python3.14 -m venv --clear .venv
                    .venv/bin/pip install --upgrade pip
                    .venv/bin/pip install -r requirements_test.txt
                    .venv/bin/python3.14 -m pytest tests/ \
                        -p no:cacheprovider \
                        --tb=short \
                        -q \
                        --junitxml=test-results.xml
                """
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'test-results.xml'
        }
        success { echo 'All tests passed.' }
        failure { echo 'Tests failed — check log above.' }
    }
}

// =============================================================================
// Jenkinsfile.sync — Merge upstream jmcollin78/versatile_thermostat into
// native-preset-mode (this fork's active branch, carries the native_preset_mode
// patch on top of upstream's main). Runs weekly (Monday 03:00).
//
// A real merge, not a fast-forward: native-preset-mode always has unique patch
// commits ahead of upstream/main, so --ff-only would fail on every run.
//
// Every new upstream release conflicts on manifest.json's "version" line (the
// fork bumps its own patch version on each release). That one case is resolved
// automatically: if manifest.json is the only conflicted file and ours/theirs
// differ in nothing but the version line, upstream's manifest is taken and the
// release step re-bumps. Any other conflict aborts the merge and fails the job
// for manual resolution.
//
// If the branch has moved past the latest v* tag (new upstream commits merged
// by this run, or a conflict resolved by hand and pushed), cuts a fork release: bumps the
// patch version in manifest.json (from the higher of the fork's and upstream's
// version, skipping any tag that already exists), tags it, and publishes a GitHub release with
// the HACS zip asset. HACS picks up the new release on its own refresh cycle —
// installing it in HA is a deliberate manual step (HACS update button), not
// done here.
// =============================================================================

pipeline {
    agent { label 'built-in' }

    triggers {
        cron('0 3 * * 1')  // Weekly Monday 03:00
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
    }

    stages {
        stage('Sync upstream → fork native-preset-mode') {
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                    sh '''
                        set -e
                        rm -rf repo
                        git clone https://github.com/d96moe/versatile_thermostat.git repo
                        cd repo
                        git config user.email "jenkins@d96moe.local"
                        git config user.name "Jenkins CI"
                        git remote add upstream https://github.com/jmcollin78/versatile_thermostat.git
                        git fetch upstream
                        git checkout native-preset-mode
                        MANIFEST=custom_components/versatile_thermostat/manifest.json
                        manifest_version() { grep -oP "\\"version\\":\\s*\\"\\K[^\\"]+" "$1"; }
                        FORK_VERSION=$(manifest_version "$MANIFEST")
                        # Per-build scratch dir: fixed /tmp names failed with "Permission
                        # denied" once a file from an earlier run (other owner) was left there.
                        SCRATCH=$(mktemp -d)
                        trap 'rm -rf "$SCRATCH"' EXIT

                        if ! git merge upstream/main -m "Merge upstream jmcollin78/main into native-preset-mode"; then
                            # The fork bumps its own patch version on every release, so
                            # each new upstream release conflicts on that one line. Resolve
                            # exactly that case (take upstream's manifest; the release step
                            # below re-bumps past both versions); anything else still fails.
                            CONFLICTS=$(git diff --name-only --diff-filter=U)
                            git show ":2:$MANIFEST" 2>/dev/null | grep -v '"version"' > "$SCRATCH/manifest_ours" || true
                            git show ":3:$MANIFEST" 2>/dev/null | grep -v '"version"' > "$SCRATCH/manifest_theirs" || true
                            if [ "$CONFLICTS" = "$MANIFEST" ] && [ -s "$SCRATCH/manifest_theirs" ] \
                                && cmp -s "$SCRATCH/manifest_ours" "$SCRATCH/manifest_theirs"; then
                                echo "=== Only the manifest version line conflicts — taking upstream's manifest ==="
                                git checkout --theirs "$MANIFEST"
                                git add "$MANIFEST"
                                git commit --no-edit
                            else
                                echo "=== Unresolvable merge conflict, manual intervention needed: ==="
                                echo "$CONFLICTS"
                                git merge --abort
                                exit 1
                            fi
                        fi
                        AFTER=$(git rev-parse HEAD)
                        git push https://x-access-token:${GH_TOKEN}@github.com/d96moe/versatile_thermostat.git native-preset-mode
                        echo "=== Sync done: native-preset-mode is now at ==="
                        git log -1 --oneline

                        # Release whenever the branch has moved past the latest fork release
                        # tag — not only when this run merged something. A conflict resolved
                        # by hand and pushed between runs must still produce a release.
                        LAST_TAG=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)
                        if [ -n "$LAST_TAG" ] && [ "$(git rev-list -n 1 "$LAST_TAG")" = "$AFTER" ]; then
                            echo "native-preset-mode is still at $LAST_TAG — nothing to release."
                            exit 0
                        fi
                        echo "=== native-preset-mode has moved past ${LAST_TAG:-<no tag>} — releasing ==="

                        # Bump from the HIGHER of the fork's pre-merge version and the
                        # merged manifest (upstream's, if the conflict was resolved
                        # above), so the version never goes backwards and never reuses
                        # an existing fork tag.
                        CURRENT_VERSION=$(manifest_version "$MANIFEST")
                        BASE_VERSION=$(printf '%s\\n%s\\n' "$FORK_VERSION" "$CURRENT_VERSION" | sort -V | tail -1)
                        MAJOR=$(echo "$BASE_VERSION" | cut -d. -f1)
                        MINOR=$(echo "$BASE_VERSION" | cut -d. -f2)
                        PATCH=$(echo "$BASE_VERSION" | cut -d. -f3)
                        PATCH=$((PATCH + 1))
                        while git rev-parse -q --verify "refs/tags/v${MAJOR}.${MINOR}.${PATCH}" >/dev/null; do
                            PATCH=$((PATCH + 1))
                        done
                        NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"
                        echo "=== Cutting fork release v$NEW_VERSION (fork was $FORK_VERSION, merged manifest $CURRENT_VERSION) ==="

                        sed -i "s/\\"version\\": \\"$CURRENT_VERSION\\"/\\"version\\": \\"$NEW_VERSION\\"/" "$MANIFEST"
                        git commit -am "Bump version to $NEW_VERSION for HACS release (native-preset-mode fork)"
                        git push https://x-access-token:${GH_TOKEN}@github.com/d96moe/versatile_thermostat.git native-preset-mode
                        git tag "v$NEW_VERSION"
                        git push https://x-access-token:${GH_TOKEN}@github.com/d96moe/versatile_thermostat.git "v$NEW_VERSION"

                        cd custom_components/versatile_thermostat
                        rm -f versatile_thermostat.zip
                        zip -rq versatile_thermostat.zip . -x "versatile_thermostat.zip"
                        cd ../..

                        RELEASE_JSON=$(curl -s -X POST \
                            -H "Authorization: token ${GH_TOKEN}" \
                            -H "Content-Type: application/json" \
                            -d "{\\"tag_name\\":\\"v$NEW_VERSION\\",\\"target_commitish\\":\\"native-preset-mode\\",\\"name\\":\\"v$NEW_VERSION\\",\\"body\\":\\"Automated sync with upstream jmcollin78 + native_preset_mode fork patches. Upstream releases: https://github.com/jmcollin78/versatile_thermostat/releases\\",\\"draft\\":false,\\"prerelease\\":false}" \
                            "https://api.github.com/repos/d96moe/versatile_thermostat/releases")

                        RELEASE_ID=$(echo "$RELEASE_JSON" | python3 -c "import sys, json; print(json.load(sys.stdin)['id'])")

                        curl -s -X POST \
                            -H "Authorization: token ${GH_TOKEN}" \
                            -H "Content-Type: application/zip" \
                            --data-binary @custom_components/versatile_thermostat/versatile_thermostat.zip \
                            "https://uploads.github.com/repos/d96moe/versatile_thermostat/releases/${RELEASE_ID}/assets?name=versatile_thermostat.zip" > /dev/null

                        echo "=== Released v$NEW_VERSION — HACS will surface the update in HA on its next refresh ==="
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Sync failed — merge conflict between upstream and native-preset-mode, or the release step errored. Manual intervention needed.'
        }
    }
}

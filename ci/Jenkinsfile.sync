// =============================================================================
// Jenkinsfile.sync — Merge upstream jmcollin78/versatile_thermostat into
// native-preset-mode (this fork's active branch, carries the native_preset_mode
// patch on top of upstream's main). Runs weekly (Monday 03:00).
//
// A real merge, not a fast-forward: native-preset-mode always has unique patch
// commits ahead of upstream/main, so --ff-only would fail on every run. If the
// merge hits a conflict, it fails here and needs manual resolution.
// =============================================================================

pipeline {
    agent { label 'built-in' }

    triggers {
        cron('0 3 * * 1')  // Weekly Monday 03:00
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
    }

    stages {
        stage('Sync upstream → fork native-preset-mode') {
            steps {
                sh """
                    git clone https://github.com/d96moe/versatile_thermostat.git repo
                    cd repo
                    git remote add upstream https://github.com/jmcollin78/versatile_thermostat.git
                    git fetch upstream
                    git checkout native-preset-mode
                    git merge upstream/main -m "Merge upstream jmcollin78/main into native-preset-mode"
                    git push origin native-preset-mode
                    echo "=== Sync done: native-preset-mode is now at ==="
                    git log -1 --oneline
                """
            }
        }
    }

    post {
        failure {
            echo 'Sync failed — merge conflict between upstream and native-preset-mode. Manual intervention needed.'
        }
    }
}
